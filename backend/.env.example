# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=native_db
DB_USERNAME=native_user
DB_PASSWORD=native_password

# --- JWT ---
# Base64 encoded secret, at least 256 bits (32 bytes) for HS256
JWT_SECRET=change-this-to-a-long-random-base64-secret-string-please
JWT_EXPIRATION_MS=86400000

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# --- Speech-to-text (practice answers) ---
# local = stt-service (recommended on Lightsail, $0 per retry)
# openai = OpenAI Whisper (costs money on every attempt)
STT_PROVIDER=local
STT_LOCAL_URL=http://stt:9000
STT_LANGUAGE=en
# tiny = fastest / least accurate, base = balanced, small = best but heavy on 1 GB RAM
WHISPER_MODEL=base
WHISPER_BEAM_SIZE=5
WHISPER_CPU_THREADS=1

# --- Email verification (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-email@example.com
MAIL_VERIFICATION_BASE_URL=http://3.21.152.118:8080/api/auth/verify
