# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=native_db
DB_USERNAME=native_user
DB_PASSWORD=native_password

# --- JWT ---
# Base64 encoded secret, at least 256 bits (32 bytes) for HS256
JWT_SECRET=change-this-to-a-long-random-base64-secret-string-please
JWT_EXPIRATION_MS=86400000

# --- OpenAI (vision / questions / TTS) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# --- Speech-to-text (practice answers) ---
# local | groq | openai
STT_PROVIDER=groq
STT_LANGUAGE=en

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your-groq-api-key
# large-v3 = max accuracy (recommended); turbo = faster/cheaper
GROQ_STT_MODEL=whisper-large-v3

# Local STT (only if STT_PROVIDER=local)
STT_LOCAL_URL=http://stt:9000
WHISPER_MODEL=base
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=1
WHISPER_COMPUTE_TYPE=int8

# --- Email verification (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-email@example.com
MAIL_VERIFICATION_BASE_URL=http://3.21.152.118:8080/api/auth/verify
